{
  "name": "smartderivbot",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @smartderivbot/web",
    "dev:worker": "npm run dev --workspace @smartderivbot/worker",
    "build": "npm run build --workspace @smartderivbot/web && npm run build --workspace @smartderivbot/worker",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @smartderivbot/worker"
  },
  "dependencies": {
    "next": "^14.2.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
